%% SafeTrace Lite - usulan arsitektur; perangkat keras belum diimplementasikan.
%% Pembentukan PNG lokal: python tools/render_diagram.py (memerlukan Pillow).
flowchart TB
    SENDER["Pengirim Perintah Tepercaya<br/>HMAC + nomor urut"]
    HPS["DE10-Nano HPS ARM<br/>UI / image / transport perintah"]
    SENSOR["Proksi Sensor Tepercaya<br/>Sakelar / ADC / GPIO"]
    subgraph FPGA["Fabric FPGA - SafeTrace Lite"]
        CONFIG["Konfigurasi Tepercaya<br/>Digest / kunci / versi / kebijakan<br/>Terlindungi setelah dikunci"]
        BOOT["Gerbang Integritas Awal<br/>SHA-256 image + versi minimum"]
        subgraph RUNTIME["Pengaman Perintah Saat Operasi"]
            HMAC["Verifikasi HMAC<br/>HMAC-SHA256"]
            REPLAY["Pengaman Replay<br/>Nomor urut meningkat"]
            POLICY["Mesin Kebijakan Keselamatan<br/>Batas nilai + kondisi sensor"]
        end
        GATE["Gerbang Keluaran<br/>ALLOW: semua syarat lolos<br/>BLOCK: keluaran tidak aktif"]
        SCHED["Penjadwal SHA<br/>Arbitrasi boot / HMAC / log"]
        SHA["Inti SHA-256 Bersama<br/>Satu mesin perangkat keras"]
        LOG["TrustLog<br/>Penghitung + rantai hash<br/>Buffer BRAM terbaru"]
    end
    ACTUATOR["Demo Aktuator<br/>LED / PWM / driver tegangan rendah"]
    STORE["Penyimpanan Audit / HPS<br/>Peristiwa + hash / relay snapshot"]
    BACKEND["Checkpoint Backend<br/>ID + penghitung + hash terakhir"]

    SENDER -->|frame autentik| HPS
    HPS -->|image + versi / Avalon-MM| BOOT
    HPS -->|transport perintah / Avalon-MM| HMAC
    CONFIG -->|digest + versi minimum| BOOT
    CONFIG -->|kunci terlindungi| HMAC
    CONFIG -->|ambang terkunci| POLICY
    BOOT -->|SYSTEM_TRUSTED| GATE
    HMAC -->|HMAC_VALID| REPLAY
    REPLAY -->|FRESH_SEQUENCE| POLICY
    SENSOR -->|kondisi proses tepercaya| POLICY
    POLICY -->|POLICY_VALID + perintah terperiksa| GATE
    GATE -->|ALLOW: GPIO/PWM terkendali| ACTUATOR
    GATE -->|ALLOW/BLOCK + alasan| LOG
    LOG -->|peristiwa + hash / snapshot FPGA| STORE
    STORE -->|HPS: ID / penghitung / hash| BACKEND
    BOOT <-.->|layanan hash| SCHED
    HMAC <-.->|layanan hash| SCHED
    LOG <-.->|layanan hash| SCHED
    SCHED <-.->|blok 512 bit / digest 256 bit| SHA

    classDef host fill:#eff5fc,stroke:#64748b,color:#152f4b
    classDef boot fill:#e7f1ff,stroke:#2563eb,color:#152f4b
    classDef action fill:#fff4de,stroke:#d49b24,color:#4d350e
    classDef crypto fill:#f0eaff,stroke:#8262bd,color:#382554
    classDef evidence fill:#e6f6f3,stroke:#1b927e,color:#164b43
    classDef config fill:#f1f5f9,stroke:#64748b,color:#152f4b
    class SENDER,HPS,SENSOR,ACTUATOR host
    class BOOT boot
    class HMAC,REPLAY,POLICY,GATE action
    class SCHED,SHA crypto
    class LOG,STORE,BACKEND evidence
    class CONFIG config
